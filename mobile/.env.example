# Copy to .env. Address of the API gateway as seen from the phone or emulator.
#   iOS simulator:       http://localhost:8080        (default)
#   Android emulator:    http://10.0.2.2:8080         (default)
#   Physical device:     http://<your computer's LAN IP>:8080
#   Production builds:   https://api.your-domain.com
EXPO_PUBLIC_API_URL=
