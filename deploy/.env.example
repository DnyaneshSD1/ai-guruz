# Copy to .env on the server (setup-server.sh does this for you). Never commit .env.

# Public hostname of the site. Before the domain is connected use the server's public IP with
# dashes plus .sslip.io (for example 203-0-113-10.sslip.io). Later: aiguruz.com, www.aiguruz.com
SITE_ADDRESS=

# Guards service-to-service endpoints. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# AI: Groq's free tier through the OpenAI-compatible provider. Key from https://console.groq.com/keys
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# The site is served over HTTPS by Caddy.
COOKIE_SECURE=true
# The gateway is reachable only through Caddy.
GATEWAY_BIND=127.0.0.1
# Browser origins allowed to call the API: the site itself (https:// + the first SITE_ADDRESS).
CORS_ALLOWED_ORIGINS=
# Caddy sits in front of the gateway, so rate limits use the client address it forwards.
TRUST_PROXY=true

# Never seed demo accounts on a public site.
SEED_DEMO=false
