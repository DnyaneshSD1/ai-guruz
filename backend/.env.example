# Used by docker-compose.yml. Copy to .env and fill in. Never commit .env.

# Guards service-to-service (/internal) endpoints. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# AI provider: ollama (local model), openai (OpenAI-compatible API such as Groq), claude (Anthropic API),
# mock (offline heuristics only)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Browser origins allowed to call the API (the web app, and Expo's web preview)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# true once the site is served over HTTPS (marks the refresh cookie Secure)
COOKIE_SECURE=false

# Optional: base64 PKCS#8 RSA private key for signing tokens. Empty = generated once and stored in MongoDB.
JWT_PRIVATE_KEY=

# true creates a demo institution with one account per role. Local demos only.
SEED_DEMO=false
